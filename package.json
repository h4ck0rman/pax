{
  "name": "pax",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env dist-server/start.js",
    "test:gate": "node --test tests/production.test.mjs",
    "test:vercel-gate": "tsc -p tsconfig.vercel-test.json && node --test tests/vercel-gate.test.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.8",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^13.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vercel": "^59.23.2",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.17.0 <23"
  }
}
